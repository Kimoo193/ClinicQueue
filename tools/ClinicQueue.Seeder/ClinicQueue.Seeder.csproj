<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ClinicQueue.Seeder</RootNamespace>
  </PropertyGroup>

  <!-- Infrastructure references the ASP.NET Core shared framework (SignalR, JwtBearer). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuse the real AppDbContext / PrivilegedDbContext / PasswordHasher so the seed
         exercises the exact production model and RLS behaviour. -->
    <ProjectReference Include="..\..\src\ClinicQueue.Infrastructure\ClinicQueue.Infrastructure.csproj" />
  </ItemGroup>

</Project>
