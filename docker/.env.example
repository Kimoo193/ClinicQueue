# Copy to .env (never commit secrets). Used by docker compose.
# Owner/superuser role (owns tables, runs EF migrations, Hangfire schema).
POSTGRES_PASSWORD=change-me-postgres
# Non-owner application role (RLS-enforced) — ConnectionStrings__Default.
APP_DB_PASSWORD=change-me-app-role
# Cross-tenant BYPASSRLS role (SuperAdmin/platform + background jobs) — ConnectionStrings__Privileged.
# Avoid single quotes in this and APP_DB_PASSWORD (consumed by postgres-init/01-roles.sh).
BYPASS_DB_PASSWORD=change-me-bypass-role
REDIS_PASSWORD=change-me-redis
JWT_SIGNING_KEY=change-me-to-a-long-random-signing-key-at-least-32-chars
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional: browser origin if SPA is not same-origin via nginx (leave empty for same-origin)
CORS_ALLOWED_ORIGIN=
# Optional: Slack/Discord webhook for health-monitor alerts (SC-010)
CLINICQUEUE_ALERT_WEBHOOK=
# Optional: path to GPG passphrase file for encrypted backups (SC-015)
CLINICQUEUE_BACKUP_PASSPHRASE_FILE=
CLINICQUEUE_BACKUP_OFFSITE=
