# Copy to .env (never commit secrets). Used by docker compose.
POSTGRES_PASSWORD=change-me-postgres
REDIS_PASSWORD=change-me-redis
JWT_SIGNING_KEY=change-me-to-a-long-random-signing-key-at-least-32-chars
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional: browser origin if SPA is not same-origin via nginx (leave empty for same-origin)
CORS_ALLOWED_ORIGIN=
# Optional: Slack/Discord webhook for health-monitor alerts (SC-010)
CLINICQUEUE_ALERT_WEBHOOK=
# Optional: path to GPG passphrase file for encrypted backups (SC-015)
CLINICQUEUE_BACKUP_PASSPHRASE_FILE=
CLINICQUEUE_BACKUP_OFFSITE=
