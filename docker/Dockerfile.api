# syntax=docker/dockerfile:1

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY ClinicQueue.slnx ./
COPY src/ClinicQueue.Domain/ClinicQueue.Domain.csproj src/ClinicQueue.Domain/
COPY src/ClinicQueue.Application/ClinicQueue.Application.csproj src/ClinicQueue.Application/
COPY src/ClinicQueue.Infrastructure/ClinicQueue.Infrastructure.csproj src/ClinicQueue.Infrastructure/
COPY src/ClinicQueue.Api/ClinicQueue.Api.csproj src/ClinicQueue.Api/

RUN dotnet restore src/ClinicQueue.Api/ClinicQueue.Api.csproj

COPY src/ src/
RUN dotnet publish src/ClinicQueue.Api/ClinicQueue.Api.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

# curl is not in the base image; docker-compose's healthcheck needs it to probe /health.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "ClinicQueue.Api.dll"]
