{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "",
    "Redis": ""
  },
  "Jwt": {
    "Issuer": "ClinicQueue",
    "Audience": "ClinicQueue",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "SigningKey": ""
  },
  "Vapid": {
    "Subject": "mailto:ops@clinicqueue.app",
    "PublicKey": "",
    "PrivateKey": ""
  },
  "Hangfire": {
    "Enabled": false,
    "ServerOnly": false
  },
  "Pagination": {
    "DefaultPageSize": 20,
    "MaxPageSize": 100
  },
  "Audit": {
    "RetentionDays": 730
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "OpenApi": {
    "EnableUi": false
  }
}
